{
  "name": "aiex-cli",
  "type": "module",
  "version": "0.0.3-beta.2",
  "description": "JSON Schema → SQLite with AI-powered data extraction",
  "author": "OSpoon <zxin088@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/OSpoon/aiex-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSpoon/aiex-cli.git"
  },
  "bugs": "https://github.com/OSpoon/aiex-cli/issues",
  "keywords": [
    "json-schema",
    "sqlite",
    "drizzle",
    "orm",
    "ai-extraction",
    "cli",
    "database-migration",
    "schema-editor",
    "code-generation",
    "structured-output"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./core/schema-sqlite/migrate-helper": "./dist/core/schema-sqlite/migrate-helper.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "aiex": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/core/schema-sqlite/migrate-helper.ts",
    "src/core/schema-sqlite/migration-name.ts"
  ],
  "scripts": {
    "build": "tsdown && pnpm --filter aiex-web build",
    "dev": "tsdown --watch",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "typecheck": "tsc",
    "lint": "eslint .",
    "prepack": "cp ../../README.md .",
    "postpack": "rm -f README.md",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@clack/prompts": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@langfuse/otel": "catalog:",
    "@notionhq/client": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "ai": "catalog:",
    "better-sqlite3": "catalog:",
    "citty": "catalog:",
    "cli-table3": "catalog:",
    "conf": "catalog:",
    "consola": "catalog:",
    "date-fns": "catalog:",
    "drizzle-kit": "catalog:cli",
    "drizzle-orm": "catalog:",
    "es-toolkit": "catalog:",
    "esbuild": "catalog:",
    "execa": "catalog:",
    "hono": "catalog:",
    "jsonfile": "catalog:",
    "jsonrepair": "catalog:",
    "kysely": "catalog:",
    "mime": "catalog:",
    "open": "catalog:",
    "p-retry": "catalog:",
    "picocolors": "catalog:",
    "proper-lockfile": "catalog:",
    "tinyglobby": "catalog:",
    "tsx": "catalog:cli",
    "unpdf": "catalog:",
    "update-notifier": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@napi-rs/system-ocr": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@types/better-sqlite3": "catalog:types",
    "@types/jsonfile": "catalog:",
    "@types/node": "catalog:types",
    "@types/proper-lockfile": "catalog:",
    "@types/update-notifier": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:cli",
    "publint": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsnapi": "catalog:testing",
    "typescript": "catalog:cli",
    "vitest": "catalog:testing"
  }
}
